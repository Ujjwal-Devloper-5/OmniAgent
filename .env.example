# ============================================================
# OmniAgent v2.0 — Multi-Agent Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# ─── Google Gemini (RECOMMENDED — configure at minimum) ───────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192

# ─── OpenAI (optional — enables GPT-4o) ──────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ─── Anthropic Claude (optional — enables Claude Sonnet) ─────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4096

# ─── Groq (optional — FREE ultra-fast inference) ─────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096

# ─── OpenRouter (optional — FREE models like Nemotron, Gemma, Llama) ─────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4096

# ─── Ollama Local (optional — fully offline fallback) ────────────────────────
# Install: https://ollama.com  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ─── Platform Tokens ─────────────────────────────────────────────────────────

# Discord: https://discord.com/developers/applications
# Required Intents: Message Content, Server Members
DISCORD_TOKEN=your_discord_bot_token_here

# Telegram: https://t.me/BotFather -> /newbot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ─── Multi-Agent Routing ─────────────────────────────────────────────────────
# "auto" = let the router decide based on task type
# Options: gemini, openai, anthropic, groq, openrouter, ollama, auto
DEFAULT_PROVIDER=auto
CODING_PROVIDER=auto
CREATIVE_PROVIDER=auto
MATH_PROVIDER=auto
QUICK_PROVIDER=auto

# Fallback order — tried left-to-right when preferred provider fails
FALLBACK_ORDER=gemini,openai,anthropic,groq,openrouter,ollama

# ─── Health Monitor ──────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_SECONDS=300
MODEL_FAILURE_THRESHOLD=3
MODEL_RECOVERY_SECONDS=300

# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=data/memory.sqlite

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_TOKENS_PER_DAY=200000

# ─── Bot Behaviour ───────────────────────────────────────────────────────────
BOT_NAME=OmniAgent
BOT_PREFIX=!
MAX_HISTORY_MESSAGES=50

# ─── Optional: Weather Tool ──────────────────────────────────────────────────
# https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/omniagent.log
