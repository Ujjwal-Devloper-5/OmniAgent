# ==============================================================================
# OmniAgent 2.0 Configuration
# Rename this file to .env and fill in the values below.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. PLATFORM TOKENS
# You must configure at least one of these to interact with the bot.
# ──────────────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ── Slack Integration ─────────────────────────────────────────────────────────
# Required for Slack integration. Set up at https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token  (enable Socket Mode in your Slack App)
# SLACK_SIGNING_SECRET=your-signing-secret

# ──────────────────────────────────────────────────────────────────────────────
# 2. AI PROVIDER API KEYS (CLOUD)
# OmniAgent routes requests dynamically. Configure as many as you want.
# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini (Primary for complex reasoning & native multimodal vision)
# Get a key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Fallback for general reasoning)
# Get a key: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Fallback for coding & creative tasks)
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (Lightning-fast inference for simple chat & tools)
# Get a free key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Aggregator providing access to 200+ models, many are FREE)
# Get a free key: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# 3. LOCAL AI (OLLAMA)
# Fully offline execution. Used as the final fallback or primary for privacy.
# ──────────────────────────────────────────────────────────────────────────────
# Note: If running OmniAgent via Docker, use http://host.docker.internal:11434
# If running locally via uv/pip, use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_TIMEOUT=120

# ──────────────────────────────────────────────────────────────────────────────
# 4. MCP (MODEL CONTEXT PROTOCOL) SERVERS
# Dynamically extend your agent with external capabilities without coding!
# Provide a JSON string mapping a server name to its command and arguments.
# Example: Adding SQLite and GitHub MCP servers via 'uvx' and 'npx'.
# ──────────────────────────────────────────────────────────────────────────────
MCP_SERVERS='{
  "github": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"]
  },
  "sqlite": {
    "command": "uvx",
    "args": ["mcp-server-sqlite", "--db-path", "data/example.db"]
  }
}'

# ──────────────────────────────────────────────────────────────────────────────
# 5. SMART ROUTING & FALLBACK CONFIGURATION
# Control how the Smart Router selects providers.
# ──────────────────────────────────────────────────────────────────────────────
# Ordered list of providers to try when one fails or rate-limits.
FALLBACK_ORDER=gemini,openai,anthropic,groq,openrouter,ollama

# You can override specific task types (auto = let the router decide based on capabilities)
DEFAULT_PROVIDER=auto
CODING_PROVIDER=auto
CREATIVE_PROVIDER=auto
MATH_PROVIDER=auto
QUICK_PROVIDER=auto

# Health monitor settings
HEALTH_CHECK_INTERVAL_SECONDS=300
MODEL_FAILURE_THRESHOLD=3
MODEL_RECOVERY_SECONDS=300

# ──────────────────────────────────────────────────────────────────────────────
# 6. OPENROUTER FREE TIER SETTINGS
# OmniAgent runs a background daemon to auto-probe these free models.
# ──────────────────────────────────────────────────────────────────────────────
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Comma-separated list of free models the auto-prober will validate and cycle.
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4096

# ──────────────────────────────────────────────────────────────────────────────
# 7. SPECIFIC MODEL OVERRIDES
# Change the default models used per provider.
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192

OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4096

# ──────────────────────────────────────────────────────────────────────────────
# 8. EXTERNAL TOOLS & UTILITIES
# ──────────────────────────────────────────────────────────────────────────────
# Needed for the `get_weather` tool. Free key from https://openweathermap.org/
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# 9. BOT BEHAVIOUR & LIMITS
# ──────────────────────────────────────────────────────────────────────────────
BOT_NAME=OmniAgent
BOT_PREFIX=!
MAX_HISTORY_MESSAGES=50
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_TOKENS_PER_DAY=200000

# ──────────────────────────────────────────────────────────────────────────────
# 10. SYSTEM PATHS & LOGGING
# If running via Docker, these paths reside inside the container volume.
# ──────────────────────────────────────────────────────────────────────────────
DB_PATH=data/memory.sqlite
LOG_LEVEL=INFO
LOG_FILE=logs/omniagent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Admin Dashboard ────────────────────────────────────────────────────────
# Set this to enable the Admin API on port 8080
# Generate a secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_API_SECRET=your_secure_random_secret_here
